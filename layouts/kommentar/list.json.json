{{- /*
  /kommentar/index.json — maschinenlesbarer Katalog für den MCP-Server (mcp/).

  Aufbau:
    gesetze   Verzeichnis ("stgb") → Kürzel, Name, SR bzw. SRL, URL, Artikel
    artikel   Verzeichnis ("art-070") → Titel, Beschreibung, Tags, URL, lastmod,
              Sachgebiete, vorhandene Teile, Prüfstand

  `verifiziert` ist wie in /themen/index.json `agent_verified` UND `mcp_verified`
  der jüngsten Revision. Den Text selbst liefert der Server aus dem Repo; hier
  steht nur, was er zum Suchen und Auflisten braucht.

  Nur für /kommentar/ erzeugt (outputs im Frontmatter von content/kommentar/_index.md).
*/ -}}
{{- $gesetze := dict -}}
{{- range .Sections -}}
  {{- $g := path.Base .Path -}}
  {{- $artikel := dict -}}
  {{- range where .Sections "Kind" "section" -}}
    {{- $slug := path.Base .Path -}}
    {{- $mcp := false -}}
    {{- with .Params.revisions -}}{{- $mcp = (index . 0).mcp_verified | default false -}}{{- end -}}
    {{- $teile := slice "kommentar" -}}
    {{- range .RegularPages -}}
      {{- $name := path.BaseName .File.LogicalName -}}
      {{- if in (slice "rechtsprechung" "strafzumessung") $name -}}{{- $teile = $teile | append $name -}}{{- end -}}
    {{- end -}}
    {{- $artikel = merge $artikel (dict $slug (dict
      "titel" .Title
      "beschreibung" (.Description | default "")
      "tags" (.Params.tags | default slice)
      "url" .Permalink
      "lastmod" (.Lastmod.Format "2006-01-02")
      "sachgebiete" (partial "sachgebiete/artikel.html" (dict "gesetz" $g "slug" $slug))
      "teile" $teile
      "agent_verified" (.Params.agent_verified | default false)
      "mcp_verified" $mcp
      "verifiziert" (and (.Params.agent_verified | default false) $mcp)
    )) -}}
  {{- end -}}
  {{- $gesetze = merge $gesetze (dict $g (dict
    "kuerzel" .Params.kuerzel
    "name" .Params.gesetz_name
    "ebene" (.Params.ebene | default "bund")
    "sr" (.Params.sr | default "")
    "srl" (.Params.srl | default "")
    "kanton" (.Params.kanton | default "")
    "url" .Permalink
    "artikel" $artikel
  )) -}}
{{- end -}}
{{- dict "erzeugt" (now.Format "2006-01-02T15:04:05Z07:00") "gesetze" $gesetze | jsonify -}}
